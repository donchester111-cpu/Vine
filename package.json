{
  "name": "vine-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22 <25" },
  "workspaces": ["packages/shared", "services/*"],
  "scripts": {
    "start:accounts": "npm --workspace @vine/accounts-api start",
    "start:store": "npm --workspace @vine/store-api start",
    "start:operations": "npm --workspace @vine/operations-api start",
    "test": "node --test tests/*.test.js",
    "check": "node --check packages/shared/src/*.js && node --check services/accounts-api/src/server.js && node --check services/store-api/src/server.js && node --check services/operations-api/src/server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "zod": "^4.1.0"
  }
}
