VINE_OWNER_USER_ID=
OWNER_SESSION_SECRET=
OWNER_PASSWORD=
VINE_STAFF_INVITE_REDIRECT_URL=https://vinestore.com.ng/vineger.html

# Transactional messages (required for passwordless Vineger links and order email notices).
# Optional paid-domain sender. Leave blank when using the free Gmail API route below.
RESEND_API_KEY=
VINE_EMAIL_FROM=

# vine_products project
PRODUCTS_SUPABASE_URL=https://xiehbdaaioifjcbnvpqf.supabase.co
PRODUCTS_SUPABASE_SERVICE_ROLE_KEY=
