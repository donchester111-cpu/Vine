# Manual bank-transfer instructions returned by the operations API.
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_REFERENCE_PREFIX=VINE

# Optional internal setting. Do not use service-role keys in the browser.
LOG_LEVEL=info
