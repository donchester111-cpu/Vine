# vine_orders_payments project
ORDERS_SUPABASE_URL=https://ybwdecxsbveiobfvwkvr.supabase.co
ORDERS_SUPABASE_SERVICE_ROLE_KEY=

# vine_operations project
OPERATIONS_SUPABASE_URL=https://sqtntfnbjtguqddvvsly.supabase.co
OPERATIONS_SUPABASE_SERVICE_ROLE_KEY=

# Paystack stays inactive until configured privately in Render.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=


# Free Gmail API delivery fallback. Set these only on the server; never in the storefront.
GMAIL_SENDER_EMAIL=vinestore1official@gmail.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
