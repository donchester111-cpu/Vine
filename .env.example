# Never commit real keys. Use Render's private environment-variable settings in production.
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:5500
CHECKOUT_ENABLED=false
DELIVERY_FEE_KOBO=0

# Supabase Auth lives in the vine_accounts project.
AUTH_SUPABASE_URL=https://jktuwbgocpixtelfxzwq.supabase.co
AUTH_SUPABASE_ANON_KEY=
ACCOUNTS_SUPABASE_SERVICE_ROLE_KEY=

# vine_products project
PRODUCTS_SUPABASE_URL=https://xiehbdaaioifjcbnvpqf.supabase.co
PRODUCTS_SUPABASE_SERVICE_ROLE_KEY=

# vine_orders_payments project
ORDERS_SUPABASE_URL=https://ybwdecxsbveiobfvwkvr.supabase.co
ORDERS_SUPABASE_SERVICE_ROLE_KEY=

# vine_operations project
OPERATIONS_SUPABASE_URL=https://sqtntfnbjtguqddvvsly.supabase.co
OPERATIONS_SUPABASE_SERVICE_ROLE_KEY=

# Paystack stays inactive until configured privately in Render.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=

# Manual bank-transfer instructions returned by the operations API.
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_REFERENCE_PREFIX=VINE

# Optional internal setting. Do not use service-role keys in the browser.
LOG_LEVEL=info
