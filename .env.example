# Never commit real keys. Use Render's private environment-variable settings in production.
NODE_ENV=development
ALLOWED_ORIGINS=https://vinestore.com.ng,https://www.vinestore.com.ng,https://store-api.donchester111.workers.dev,http://localhost:8080,http://127.0.0.1:5500
CHECKOUT_ENABLED=false
DELIVERY_FEE_KOBO=0

# Supabase Auth lives in the vine_accounts project.
AUTH_SUPABASE_URL=https://jktuwbgocpixtelfxzwq.supabase.co
AUTH_SUPABASE_ANON_KEY=
ACCOUNTS_SUPABASE_SERVICE_ROLE_KEY=
