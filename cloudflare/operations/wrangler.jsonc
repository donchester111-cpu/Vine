{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "vine-operations-api-cf",
  "main": "./worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "OperationsContainer",
      "max_instances": 1,
      "scheduling_policy": "durable_object",
      "images": {
        "operations": {
          "dockerfile": "../../Dockerfile.operations"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OPERATIONS_CONTAINER",
        "class_name": "OperationsContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "OperationsContainer"
      ]
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "AUTH_SUPABASE_URL": "https://jktuwbgocpixtelfxzwq.supabase.co",
    "VINE_OWNER_EMAIL": "donchester111@gmail.com",
    "GMAIL_SENDER_EMAIL": "vinestore1official@gmail.com",
    "PRODUCTS_SUPABASE_URL": "https://xiehbdaaioifjcbnvpqf.supabase.co",
    "ORDERS_SUPABASE_URL": "https://ybwdecxsbveiobfvwkvr.supabase.co",
    "OPERATIONS_SUPABASE_URL": "https://sqtntfnbjtguqddvvsly.supabase.co"
  }
}
