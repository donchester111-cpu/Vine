{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "operations-api",
  "main": "worker.js",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
