{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "vine-store-api-cf",
  "main": "./worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "StoreContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "store": {
          "dockerfile": "../../Dockerfile.store"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STORE_CONTAINER",
        "class_name": "StoreContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "StoreContainer"
      ]
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "AUTH_SUPABASE_URL": "https://jktuwbgocpixtelfxzwq.supabase.co",
    "VINE_OWNER_EMAIL": "donchester111@gmail.com",
    "PRODUCTS_SUPABASE_URL": "https://xiehbdaaioifjcbnvpqf.supabase.co",
    "VINE_PRODUCT_IMAGES_BUCKET": "vine-product-images",
    "VINE_STOREFRONT_URL": "https://vinestore.com.ng",
    "ORDERS_SUPABASE_URL": "https://ybwdecxsbveiobfvwkvr.supabase.co",
    "CHECKOUT_ENABLED": "true",
    "DELIVERY_FEE_KOBO": "0"
  }
}
